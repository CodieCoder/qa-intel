{
  "name": "@qutecoder/qa-intel",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": {
    "name": "CodieCoder"
  },
  "description": "Portable QA Intel — Gherkin to validated features via Playwright",
  "keywords": [
    "qa",
    "testing",
    "test-automation",
    "playwright",
    "gherkin",
    "bdd",
    "e2e",
    "acceptance-tests",
    "agentic",
    "llm",
    "validation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodieCoder/qa-agent.git"
  },
  "bugs": {
    "url": "https://github.com/CodieCoder/qa-agent/issues"
  },
  "homepage": "https://github.com/CodieCoder/qa-agent#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qa-runner": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js",
    "lint": "echo \"skip\"",
    "typecheck": "tsc --noEmit",
    "check:fast": "npm run build && node --test tests/package-smoke.test.mjs",
    "test": "tsc && node --test tests/*.test.mjs",
    "test:node": "tsc && node --test tests/*.test.mjs",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "bump:prerelease": "npm version prerelease --preid next --no-git-tag-version",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run build && npm test && npm pack --dry-run",
    "release:publish": "npm publish --access public",
    "generate:element-kinds": "tsc && node scripts/generate-element-kinds-doc.mjs",
    "run:example": "tsc && node dist/cli.js examples/login.feature"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "playwright": "^1.44.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
