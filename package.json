{
  "name": "@codie/qa-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Portable QA agent — Gherkin to validated features via Playwright",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qa-runner": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js",
    "lint": "echo \"skip\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test tests/*.test.mjs",
    "test:node": "tsc && node --test tests/*.test.mjs",
    "generate:element-kinds": "tsc && node scripts/generate-element-kinds-doc.mjs",
    "run:example": "tsc && node dist/cli.js examples/login.feature"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "playwright": "^1.44.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
